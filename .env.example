# Copy to .env and fill in. Never commit .env.
# Every value is checked when the server starts, so a mistake fails fast with a clear message.

# "development" for your laptop, "production" for the live site (turns on stricter checks).
JENIUS_ENV=development

# Local default is a SQLite file. In production use PostgreSQL, for example:
#   DATABASE_URL=postgresql://jenius:jenius@localhost:5432/jenius
# (postgres:// and postgresql:// URLs from Render, Railway, Neon or Supabase work as-is.)
DATABASE_URL=sqlite:///./data/jenius.db

# The address people use to open Jenius. Used for password-reset links and the cross-site request check.
PUBLIC_URL=http://localhost:8000
# Extra browser origins allowed to call the API (comma separated). Usually leave empty.
ALLOWED_ORIGINS=

# The assistant. "anthropic" uses Claude (needs a key); "offline" uses the free built-in answer engine.
LLM_PROVIDER=offline
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high: how hard Claude thinks before answering (higher costs more).
ANTHROPIC_EFFORT=medium

# Claude messages each person may send per day (protects your API bill).
FREE_DAILY_MESSAGES=25
PRO_DAILY_MESSAGES=300

# Uploads
MAX_UPLOAD_MB=5
FREE_MAX_ROWS=5000
PRO_MAX_ROWS=200000

# Billing (manual UPI verification). Prices are in rupees.
UPI_ID=
# Shown on the pricing page for Enterprise enquiries and in the privacy page.
SUPPORT_EMAIL=
PRO_MONTHLY_INR=799
PRO_ANNUAL_INR=6708

# Password-reset email. Leave SMTP_HOST empty to print reset links to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Jenius <no-reply@example.com>
SMTP_STARTTLS=true
